{
  "manifest_version": 3,
  "name": "TeamSync",
  "description": "Stay in sync — messages, tasks, and notifications from your TeamSync workspaces.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "TeamSync",
    "default_icon": {
      "16": "assets/icon-128.png",
      "48": "assets/icon-128.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-128.png",
    "48": "assets/icon-128.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://teamsync-chi.vercel.app/*",
    "https://*.supabase.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
